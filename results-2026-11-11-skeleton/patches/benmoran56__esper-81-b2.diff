+def test_add_component_to_missing_entity(world):
+    with pytest.raises(KeyError):
+        world.add_component(123, ComponentA())
+    assert not world.entity_exists(123)
+    assert not world.has_component(world.create_entity(), ComponentA)
+
+
+def test_remove_last_component_keeps_entity(world):
+    entity = world.create_entity(ComponentA())
+    world.remove_component(entity, ComponentA)
+    assert world.entity_exists(entity)
+    assert world.components_for_entity(entity) == ()
